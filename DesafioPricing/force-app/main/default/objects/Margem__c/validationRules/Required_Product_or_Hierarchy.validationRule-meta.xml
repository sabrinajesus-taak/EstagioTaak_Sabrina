<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Required_Product_or_Hierarchy</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
    AND(ISBLANK(Product__c), ISBLANK(ProductHierarchy__c)),
    AND(NOT(ISBLANK(Product__c)), NOT(ISBLANK(ProductHierarchy__c)))
)</errorConditionFormula>
    <errorMessage>Você deve informar um Produto OU uma Hierarquia de Produto, mas nunca os dois ao mesmo tempo ou nenhum deles.</errorMessage>
</ValidationRule>
