<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Imposto_ativo</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Status__c, &quot;Approved&quot;) &amp;&amp; 
(ISCHANGED(Product__c) || ISCHANGED(ProductHierarchy__c) || ISCHANGED(TaxRate__c) || ISCHANGED(DistributionCenter__c) || ISCHANGED(State__c))</errorConditionFormula>
    <errorMessage>Este registro de Frete está Ativo e não permite edições. Para alterar o valor, mude o status para Rascunho ou crie um novo registro.</errorMessage>
</ValidationRule>
