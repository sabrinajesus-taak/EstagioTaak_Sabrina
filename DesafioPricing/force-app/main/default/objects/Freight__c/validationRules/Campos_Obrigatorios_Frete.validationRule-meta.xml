<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Campos_Obrigatorios_Frete</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
ISBLANK(DistributionCenter__c),
ISBLANK(FreightValue__c)
)</errorConditionFormula>
