66.0 APEX_CODE,DEBUG;APEX_PROFILING,INFO
Execute Anonymous: // 1. DADOS DO PEDIDO (Pegando Cidade, CD e o ESTADO que a Regra de Validação exige)
Execute Anonymous: Order ped = [SELECT Id, DistributionCenter__c, City__c, ShippingState, AccountId 
Execute Anonymous:              FROM Order WHERE OrderNumber = '00000100' LIMIT 1];
Execute Anonymous: 
Execute Anonymous: // Busca a Colheitadeira
Execute Anonymous: OrderItem item = [SELECT Id, Product2Id FROM OrderItem 
Execute Anonymous:                  WHERE OrderId = :ped.Id AND Product2.Name LIKE '%Colheitadeira%' LIMIT 1];
Execute Anonymous: 
Execute Anonymous: // 2. LIMPEZA
Execute Anonymous: delete [SELECT Id FROM Margem__c WHERE Product__c = :item.Product2Id];
Execute Anonymous: delete [SELECT Id FROM Freight__c WHERE Product__c = :item.Product2Id];
Execute Anonymous: 
Execute Anonymous: // 3. CRIA A MARGEM (Match: Produto + Conta + Cidade + CD)
Execute Anonymous: insert new Margem__c(
Execute Anonymous:     Product__c = item.Product2Id,
Execute Anonymous:     Account__c = ped.AccountId,
Execute Anonymous:     City__c = ped.City__c,
Execute Anonymous:     DistributionCenter__c = ped.DistributionCenter__c,
Execute Anonymous:     MarginValuePercent__c = 45,
Execute Anonymous:     Status__c = 'Approved'
Execute Anonymous: );
Execute Anonymous: 
Execute Anonymous: // 4. CRIA O FRETE (Match: Produto + Estado + CD) - AGORA COM O ESTADO DO PEDIDO!
Execute Anonymous: insert new Freight__c(
Execute Anonymous:     Product__c = item.Product2Id,
Execute Anonymous:     State__c = ped.ShippingState,      // <--- O que faltava para a Regra de Validação!
Execute Anonymous:     City__c = ped.City__c,
Execute Anonymous:     DistributionCenter__c = ped.DistributionCenter__c,
Execute Anonymous:     FreightValue__c = 50.00,
Execute Anonymous:     Status__c = 'Approved'
Execute Anonymous: );
Execute Anonymous: 
Execute Anonymous: // 5. UPDATE PARA CALCULAR
Execute Anonymous: update item;
Execute Anonymous: 
Execute Anonymous: // 6. VERIFICAÇÃO FINAL
Execute Anonymous: OrderItem res = [SELECT MarginPercentage__c, FreightValue__c, UnitPrice FROM OrderItem WHERE Id = :item.Id];
Execute Anonymous: 
Execute Anonymous: System.debug('--- 🏆 AGORA O SALESFORCE DEIXOU! ---');
Execute Anonymous: System.debug('Estado do Pedido: ' + ped.ShippingState);
Execute Anonymous: System.debug('Margem Gravada: ' + res.MarginPercentage__c + '%');
Execute Anonymous: System.debug('Frete Gravado: R$ ' + res.FreightValue__c);
Execute Anonymous: System.debug('Preço Final: R$ ' + res.UnitPrice);
Execute Anonymous: 
Execute Anonymous: if(res.MarginPercentage__c == 45) {
Execute Anonymous:     System.debug('✅ SUCESSO ABSOLUTO! O 45% finalmente apareceu!');
Execute Anonymous: }
