66.0 APEX_CODE,DEBUG;APEX_PROFILING,INFO
Execute Anonymous: // 1. SETUP DO PRODUTO E PEDIDO
Execute Anonymous: Product2 prod = [SELECT Id, ProductHierarchy__c FROM Product2 WHERE Name = 'GenWatt Diesel 1000kW' LIMIT 1];
Execute Anonymous: Order ped = [SELECT Id, AccountId, City__c, State__c, DistributionCenter__c, Pricebook2Id 
Execute Anonymous:              FROM Order WHERE OrderNumber = '00000100' LIMIT 1]; 
Execute Anonymous: 
Execute Anonymous: PricebookEntry pbe = [SELECT Id, UnitPrice FROM PricebookEntry 
Execute Anonymous:                       WHERE Product2Id = :prod.Id AND Pricebook2Id = :ped.Pricebook2Id LIMIT 1];
Execute Anonymous: 
Execute Anonymous: Account acc = [SELECT Id, AccountGroup__c FROM Account WHERE Id = :ped.AccountId];
Execute Anonymous: 
Execute Anonymous: // 2. LIMPEZA
Execute Anonymous: delete [SELECT Id FROM Margem__c WHERE Product__c = :prod.Id OR ProductHierarchy__c = :prod.ProductHierarchy__c];
Execute Anonymous: 
Execute Anonymous: // 3. CRIANDO OS NÍVEIS SEPARADOS (Respeitando sua Regra de Validação)
Execute Anonymous: List<Margem__c> margens = new List<Margem__c>();
Execute Anonymous: 
Execute Anonymous: // Nível Super Específico: SÓ PRODUTO + Conta + Cidade -> 45%
Execute Anonymous: margens.add(new Margem__c(
Execute Anonymous:     Product__c = prod.Id, 
Execute Anonymous:     ProductHierarchy__c = null, // Deixando nulo para a regra não reclamar
Execute Anonymous:     Account__c = acc.Id, 
Execute Anonymous:     City__c = ped.City__c, 
Execute Anonymous:     DistributionCenter__c = ped.DistributionCenter__c, 
Execute Anonymous:     MarginValuePercent__c = 45, 
Execute Anonymous:     Status__c = 'Approved'
Execute Anonymous: ));
Execute Anonymous: 
Execute Anonymous: // Nível Geral: SÓ HIERARQUIA + CD -> 10%
Execute Anonymous: margens.add(new Margem__c(
Execute Anonymous:     Product__c = null, // Deixando nulo para a regra não reclamar
Execute Anonymous:     ProductHierarchy__c = prod.ProductHierarchy__c, 
Execute Anonymous:     DistributionCenter__c = ped.DistributionCenter__c,
Execute Anonymous:     MarginValuePercent__c = 10, 
Execute Anonymous:     Status__c = 'Approved'
Execute Anonymous: ));
Execute Anonymous: 
Execute Anonymous: insert margens; // Agora a Regra de Validação vai deixar passar! ✅
Execute Anonymous: 
Execute Anonymous: // 4. INSERÇÃO DO ITEM
Execute Anonymous: OrderItem novoItem = new OrderItem(
Execute Anonymous:     OrderId = ped.Id, 
Execute Anonymous:     Product2Id = prod.Id, 
Execute Anonymous:     PricebookEntryId = pbe.Id,
Execute Anonymous:     Quantity = 1, 
Execute Anonymous:     UnitPrice = pbe.UnitPrice
Execute Anonymous: );
Execute Anonymous: insert novoItem;
Execute Anonymous: 
Execute Anonymous: // 5. VERIFICAÇÃO FINAL
Execute Anonymous: OrderItem result = [SELECT MarginPercentage__c, UnitPrice FROM OrderItem WHERE Id = :novoItem.Id];
Execute Anonymous: 
Execute Anonymous: System.debug('--- 🏆 VALIDAÇÃO DOS 18 NÍVEIS ---');
Execute Anonymous: System.debug('Margem aplicada (Esperado 45%): ' + result.MarginPercentage__c + '%');
Execute Anonymous: System.debug('Preço Final Calculado: R$ ' + result.UnitPrice);
Execute Anonymous: 
Execute Anonymous: if(result.MarginPercentage__c == 45) {
Execute Anonymous:     System.debug('✅ CRITÉRIO DE ACEITE 1 ATENDIDO: Priorização correta!');
Execute Anonymous: }
