Execute Anonymous: // 1. Pega a tabela Standard real da sua Org
Execute Anonymous: Id standardPBId = [SELECT Id FROM Pricebook2 WHERE IsStandard = true LIMIT 1].Id;
Execute Anonymous: 
Execute Anonymous: // 2. Pega o preço da Colheitadeira que você acabou de criar
Execute Anonymous: PricebookEntry pbe = [SELECT Id, UnitPrice, Product2Id FROM PricebookEntry 
Execute Anonymous:                       WHERE Product2.Name LIKE '%Colheitadeira%' 
Execute Anonymous:                       AND Pricebook2Id = :standardPBId AND IsActive = true LIMIT 1];
Execute Anonymous: 
Execute Anonymous: // 3. Pega o seu pedido e ATUALIZA ele para usar a tabela certa
Execute Anonymous: Order ped = [SELECT Id, Pricebook2Id FROM Order WHERE OrderNumber = '00000100' LIMIT 1];
Execute Anonymous: ped.Pricebook2Id = standardPBId;
Execute Anonymous: update ped; // Agora o Pedido e o Produto estão na mesma "família"
Execute Anonymous: 
Execute Anonymous: // 4. Insere o item direto
Execute Anonymous: OrderItem finalItem = new OrderItem(
Execute Anonymous:     OrderId = ped.Id,
Execute Anonymous:     Product2Id = pbe.Product2Id,
Execute Anonymous:     PricebookEntryId = pbe.Id,
Execute Anonymous:     Quantity = 1,
Execute Anonymous:     UnitPrice = pbe.UnitPrice
Execute Anonymous: );
Execute Anonymous: 
Execute Anonymous: insert finalItem;
Execute Anonymous: 
Execute Anonymous: // 5. O GRAN FINALE: Ver o resultado calculado pela sua Trigger!
Execute Anonymous: OrderItem result = [SELECT MarginPercentage__c, UnitPrice, FreightValue__c FROM OrderItem WHERE Id = :finalItem.Id];
Execute Anonymous: 
Execute Anonymous: System.debug('--- 🏆 FINALMENTE, SABRINA! VOCÊ VENCEU! ---');
Execute Anonymous: System.debug('Margem calculada: ' + result.MarginPercentage__c + '%');
Execute Anonymous: System.debug('Preço final: R$ ' + result.UnitPrice);
