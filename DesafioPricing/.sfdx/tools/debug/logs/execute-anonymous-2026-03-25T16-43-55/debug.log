Execute Anonymous: // 1. PEGA O PEDIDO E A COLHEITADEIRA (DNA do Pedido)
Execute Anonymous: Order ped = [SELECT Id, DistributionCenter__c, City__c, State__c, AccountId, ShippingState 
Execute Anonymous:              FROM Order WHERE OrderNumber = '00000100' LIMIT 1];
Execute Anonymous: 
Execute Anonymous: // Busca o item que a gente já inseriu (garantindo que estamos no registro certo)
Execute Anonymous: OrderItem item = [SELECT Id, Product2Id, PricebookEntryId FROM OrderItem 
Execute Anonymous:                  WHERE OrderId = :ped.Id AND Product2.Name LIKE '%Colheitadeira%' LIMIT 1];
Execute Anonymous: 
Execute Anonymous: // 2. LIMPEZA (Para não ter lixo de teste anterior)
Execute Anonymous: delete [SELECT Id FROM Margem__c WHERE Product__c = :item.Product2Id];
Execute Anonymous: delete [SELECT Id FROM Freight__c WHERE Product__c = :item.Product2Id];
Execute Anonymous: // delete [SELECT Id FROM Imposto__c WHERE Product__c = :item.Product2Id]; // Descomente se tiver objeto de Imposto
Execute Anonymous: 
Execute Anonymous: // 3. CRIA A MARGEM (45%) - MATCH COM SEU SCRIPT (Produto + Conta + Cidade)
Execute Anonymous: insert new Margem__c(
Execute Anonymous:     Product__c = item.Product2Id,
Execute Anonymous:     Account__c = ped.AccountId,
Execute Anonymous:     City__c = ped.City__c,
Execute Anonymous:     MarginValuePercent__c = 45,
Execute Anonymous:     Status__c = 'Approved'
Execute Anonymous: );
Execute Anonymous: 
Execute Anonymous: // 4. CRIA O FRETE (Exemplo: R$ 50,00) - MATCH COM SEU SCRIPT (Produto + Cidade + CD)
Execute Anonymous: insert new Freight__c(
Execute Anonymous:     Product__c = item.Product2Id,
Execute Anonymous:     City__c = ped.City__c,
Execute Anonymous:     DistributionCenter__c = ped.DistributionCenter__c,
Execute Anonymous:     FreightValue__c = 50.00,
Execute Anonymous:     Status__c = 'Approved'
Execute Anonymous: );
Execute Anonymous: 
Execute Anonymous: // 5. DISPARA O CÁLCULO (Update no item chama a Trigger -> chama o PricingService)
Execute Anonymous: update item;
Execute Anonymous: 
Execute Anonymous: // 6. O GRANDE FINAL (Auditando os campos)
Execute Anonymous: OrderItem res = [SELECT MarginPercentage__c, FreightValue__c, UnitPrice FROM OrderItem WHERE Id = :item.Id];
Execute Anonymous: 
Execute Anonymous: System.debug('--- 🏁 RESULTADO DA AUDITORIA ---');
Execute Anonymous: System.debug('Margem Aplicada: ' + res.MarginPercentage__c + '%');
Execute Anonymous: System.debug('Frete Aplicado: R$ ' + res.FreightValue__c);
Execute Anonymous: System.debug('Preço Final Calculado: R$ ' + res.UnitPrice);
Execute Anonymous: 
Execute Anonymous: if(res.MarginPercentage__c == 45) {
Execute Anonymous:     System.debug('✅ VITÓRIA! A CLASSE PREENCHEU A MARGEM E FEZ A CONTA!');
Execute Anonymous: } else {
Execute Anonymous:     System.debug('❌ A Margem ainda está null. Verifique se os nomes dos campos no SELECT do PricingService batem com o Objeto.');
Execute Anonymous: }
