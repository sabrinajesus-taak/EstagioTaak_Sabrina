Execute Anonymous: // 1. Limpando o terreno
Execute Anonymous: Order ped = [SELECT Id, Pricebook2Id FROM Order WHERE OrderNumber = '00000100' LIMIT 1];
Execute Anonymous: delete [SELECT Id FROM OrderItem WHERE OrderId = :ped.Id]; // Remove o GenWatt ou qualquer outro que esteja lá
Execute Anonymous: 
Execute Anonymous: // 2. Configura a tabela certa agora que o pedido está vazio
Execute Anonymous: Id standardPBId = [SELECT Id FROM Pricebook2 WHERE IsStandard = true LIMIT 1].Id;
Execute Anonymous: ped.Pricebook2Id = standardPBId;
Execute Anonymous: update ped;
Execute Anonymous: 
Execute Anonymous: // 3. Pega o preço da Colheitadeira
Execute Anonymous: PricebookEntry pbe = [SELECT Id, UnitPrice, Product2Id FROM PricebookEntry 
Execute Anonymous:                       WHERE Product2.Name LIKE '%Colheitadeira%' 
Execute Anonymous:                       AND Pricebook2Id = :standardPBId AND IsActive = true LIMIT 1];
Execute Anonymous: 
Execute Anonymous: // 4. Cria a MARGEM (Criterio 1: 18 níveis)
Execute Anonymous: delete [SELECT Id FROM Margem__c WHERE Product__c = :pbe.Product2Id];
Execute Anonymous: Margem__c m = new Margem__c(
Execute Anonymous:     Product__c = pbe.Product2Id,
Execute Anonymous:     MarginValuePercent__c = 45,
Execute Anonymous:     Status__c = 'Approved',
Execute Anonymous:     DistributionCenter__c = [SELECT Id FROM DistributionCenter__c LIMIT 1].Id // Pega um CD qualquer
Execute Anonymous: );
Execute Anonymous: insert m;
Execute Anonymous: 
Execute Anonymous: // 5. Insere o item final
Execute Anonymous: OrderItem finalItem = new OrderItem(
Execute Anonymous:     OrderId = ped.Id,
Execute Anonymous:     Product2Id = pbe.Product2Id,
Execute Anonymous:     PricebookEntryId = pbe.Id,
Execute Anonymous:     Quantity = 1,
Execute Anonymous:     UnitPrice = pbe.UnitPrice
Execute Anonymous: );
Execute Anonymous: insert finalItem;
Execute Anonymous: 
Execute Anonymous: // 6. RESULTADO
Execute Anonymous: OrderItem res = [SELECT MarginPercentage__c, UnitPrice FROM OrderItem WHERE Id = :finalItem.Id];
Execute Anonymous: System.debug('--- 🏆 ACABOU O PERRENGUE! ---');
Execute Anonymous: System.debug('Margem: ' + res.MarginPercentage__c + '%');
Execute Anonymous: System.debug('Preço: R$ ' + res.UnitPrice);
