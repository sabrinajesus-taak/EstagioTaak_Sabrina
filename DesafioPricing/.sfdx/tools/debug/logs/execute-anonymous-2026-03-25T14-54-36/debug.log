Execute Anonymous: // 1. DADOS DO PEDIDO
Execute Anonymous: Order ped = [SELECT Id, DistributionCenter__c, City__c, AccountId FROM Order WHERE OrderNumber = '00000100' LIMIT 1];
Execute Anonymous: OrderItem item = [SELECT Id, Product2Id FROM OrderItem WHERE OrderId = :ped.Id LIMIT 1];
Execute Anonymous: 
Execute Anonymous: // 2. LIMPEZA TOTAL
Execute Anonymous: delete [SELECT Id FROM Margem__c WHERE Product__c = :item.Product2Id];
Execute Anonymous: 
Execute Anonymous: // 3. CRIA A MARGEM (Apenas com o que você REALMENTE tem)
Execute Anonymous: Margem__c m1 = new Margem__c();
Execute Anonymous: m1.Product__c = item.Product2Id;
Execute Anonymous: m1.Account__c = ped.AccountId; // Incluí a conta por via das dúvidas
Execute Anonymous: m1.DistributionCenter__c = ped.DistributionCenter__c;
Execute Anonymous: m1.City__c = ped.City__c;
Execute Anonymous: m1.MarginValuePercent__c = 45;
Execute Anonymous: m1.Status__c = 'Approved'; // Verifique se no seu objeto é 'Approved' ou 'Aprovado'
Execute Anonymous: insert m1;
Execute Anonymous: 
Execute Anonymous: // 4. VERIFICAÇÃO MANUAL (O SELECT que a Trigger deveria fazer)
Execute Anonymous: Margem__c conferencia = [SELECT Id, Product__c, City__c, DistributionCenter__c, Status__c 
Execute Anonymous:                          FROM Margem__c WHERE Id = :m1.Id];
Execute Anonymous: 
Execute Anonymous: System.debug('--- 🔍 CONFERINDO A MARGEM CRIADA ---');
Execute Anonymous: System.debug('Produto na Margem: ' + conferencia.Product__c);
Execute Anonymous: System.debug('Cidade na Margem: ' + conferencia.City__c);
Execute Anonymous: System.debug('Status na Margem: ' + conferencia.Status__c);
Execute Anonymous: 
Execute Anonymous: // 5. UPDATE PARA TESTAR A TRIGGER
Execute Anonymous: update item;
Execute Anonymous: 
Execute Anonymous: // 6. RESULTADO
Execute Anonymous: OrderItem res = [SELECT MarginPercentage__c, UnitPrice FROM OrderItem WHERE Id = :item.Id];
Execute Anonymous: System.debug('--- 🏆 RESULTADO FINAL ---');
Execute Anonymous: System.debug('Margem no Item: ' + res.MarginPercentage__c + '%');
