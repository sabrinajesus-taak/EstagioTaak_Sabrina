66.0 APEX_CODE,DEBUG;APEX_PROFILING,INFO
Execute Anonymous: // 1. PEGA OS DADOS DO PEDIDO
Execute Anonymous: Order ped = [SELECT Id, AccountId, City__c, State__c, Country__c, DistributionCenter__c 
Execute Anonymous:              FROM Order WHERE OrderNumber = '00000100' LIMIT 1];
Execute Anonymous: 
Execute Anonymous: // Busca o item da Colheitadeira
Execute Anonymous: OrderItem item = [SELECT Id, Product2Id FROM OrderItem 
Execute Anonymous:                  WHERE OrderId = :ped.Id AND Product2.Name LIKE '%Colheitadeira%' LIMIT 1];
Execute Anonymous: 
Execute Anonymous: // 2. LIMPEZA TOTAL (Para garantir que a Trigger busque os novos)
Execute Anonymous: delete [SELECT Id FROM Margem__c WHERE Product__c = :item.Product2Id];
Execute Anonymous: delete [SELECT Id FROM Freight__c WHERE Product__c = :item.Product2Id];
Execute Anonymous: 
Execute Anonymous: // 3. CRIA A MARGEM (Match: Produto + Conta + Cidade + CD)
Execute Anonymous: // O Status 'Approved' deve bater com o SELECT da sua Trigger
Execute Anonymous: insert new Margem__c(
Execute Anonymous:     Product__c = item.Product2Id,
Execute Anonymous:     Account__c = ped.AccountId,
Execute Anonymous:     City__c = ped.City__c,
Execute Anonymous:     State__c = ped.State__c,
Execute Anonymous:     DistributionCenter__c = ped.DistributionCenter__c,
Execute Anonymous:     MarginValuePercent__c = 45,
Execute Anonymous:     Status__c = 'Approved' 
Execute Anonymous: );
Execute Anonymous: 
Execute Anonymous: // 4. CRIA O FRETE (R$ 50,00)
Execute Anonymous: insert new Freight__c(
Execute Anonymous:     Product__c = item.Product2Id,
Execute Anonymous:     State__c = ped.State__c,
Execute Anonymous:     City__c = ped.City__c,
Execute Anonymous:     DistributionCenter__c = ped.DistributionCenter__c,
Execute Anonymous:     FreightValue__c = 50.00,
Execute Anonymous:     Status__c = 'Approved'
Execute Anonymous: );
Execute Anonymous: 
Execute Anonymous: // 5. O PULO DO GATO: ZERAR OS CAMPOS NO ITEM ANTES DO UPDATE
Execute Anonymous: // Isso força a Trigger a preencher do zero e a gente vê a mudança!
Execute Anonymous: item.MarginPercentage__c = null;
Execute Anonymous: item.FreightValue__c = null;
Execute Anonymous: update item;
Execute Anonymous: 
Execute Anonymous: // 6. VERIFICAÇÃO FINAL (O MOMENTO DO PRINT!)
Execute Anonymous: OrderItem res = [SELECT MarginPercentage__c, FreightValue__c, UnitPrice FROM OrderItem WHERE Id = :item.Id];
Execute Anonymous: 
Execute Anonymous: System.debug('--- 🏆 AGORA SIM, SABRINA! ---');
Execute Anonymous: System.debug('Margem Encontrada: ' + res.MarginPercentage__c + '%');
Execute Anonymous: System.debug('Frete Encontrado: R$ ' + res.FreightValue__c);
Execute Anonymous: System.debug('Preço Final com Margem: R$ ' + res.UnitPrice);
Execute Anonymous: 
Execute Anonymous: if(res.MarginPercentage__c != null && res.MarginPercentage__c > 0) {
Execute Anonymous:     System.debug('✅ TUDO CERTINHO! PODE TIRAR O PRINT!');
Execute Anonymous: } else {
Execute Anonymous:     System.debug('❓ Se ainda der null, verifique se a sua Trigger OrdemItemHandler está ATIVA nas Configurações.');
Execute Anonymous: }
