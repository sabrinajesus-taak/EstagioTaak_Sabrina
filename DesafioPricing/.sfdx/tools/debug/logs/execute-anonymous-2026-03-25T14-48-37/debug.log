66.0 APEX_CODE,DEBUG;APEX_PROFILING,INFO
Execute Anonymous: // 1. Pega o CD e a Cidade que estão DE FATO no seu pedido
Execute Anonymous: Order ped = [SELECT Id, DistributionCenter__c, City__c FROM Order WHERE OrderNumber = '00000100' LIMIT 1];
Execute Anonymous: 
Execute Anonymous: // 2. Pega o item da Colheitadeira que a gente acabou de inserir
Execute Anonymous: OrderItem item = [SELECT Id, Product2Id FROM OrderItem WHERE OrderId = :ped.Id LIMIT 1];
Execute Anonymous: 
Execute Anonymous: // 3. ATUALIZA A MARGEM para o CD/Cidade do pedido (O "casamento" dos dados)
Execute Anonymous: delete [SELECT Id FROM Margem__c WHERE Product__c = :item.Product2Id];
Execute Anonymous: insert new Margem__c(
Execute Anonymous:     Product__c = item.Product2Id,
Execute Anonymous:     DistributionCenter__c = ped.DistributionCenter__c, // Usa o CD do pedido!
Execute Anonymous:     City__c = ped.City__c,                             // Usa a Cidade do pedido!
Execute Anonymous:     MarginValuePercent__c = 45,
Execute Anonymous:     Status__c = 'Approved'
Execute Anonymous: );
Execute Anonymous: 
Execute Anonymous: // 4. DÁ UM "TOTÓ" NO ITEM PARA A TRIGGER RECALCULAR
Execute Anonymous: update item;
Execute Anonymous: 
Execute Anonymous: // 5. O PRINT DA VITÓRIA
Execute Anonymous: OrderItem res = [SELECT MarginPercentage__c, UnitPrice FROM OrderItem WHERE Id = :item.Id];
Execute Anonymous: System.debug('--- 🏁 AGORA SIM, SABRINA! 45% NA TELA! ---');
Execute Anonymous: System.debug('Margem Final: ' + res.MarginPercentage__c + '%');
Execute Anonymous: System.debug('Preço com Margem: R$ ' + res.UnitPrice);
