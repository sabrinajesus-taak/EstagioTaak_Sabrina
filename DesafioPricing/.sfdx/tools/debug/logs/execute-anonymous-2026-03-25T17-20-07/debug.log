Execute Anonymous: // 1. SETUP: Identificar o Pedido e o Item
Execute Anonymous: Order ped = [SELECT Id, City__c, State__c, DistributionCenter__c FROM Order WHERE OrderNumber = '00000100' LIMIT 1];
Execute Anonymous: OrderItem item = [SELECT Id, Product2Id FROM OrderItem WHERE OrderId = :ped.Id LIMIT 1];
Execute Anonymous: 
Execute Anonymous: // 2. LIMPEZA E CRIAÇÃO DE DOIS NÍVEIS DE FRETE
Execute Anonymous: delete [SELECT Id FROM Freight__c WHERE Product__c = :item.Product2Id];
Execute Anonymous: 
Execute Anonymous: // Nível 1: Frete por CIDADE (Mais específico - R$ 500)
Execute Anonymous: Freight__c freteCidade = new Freight__c(
Execute Anonymous:     Product__c = item.Product2Id,
Execute Anonymous:     City__c = ped.City__c,
Execute Anonymous:     DistributionCenter__c = ped.DistributionCenter__c,
Execute Anonymous:     FreightValue__c = 500.00,
Execute Anonymous:     Status__c = 'Approved'
Execute Anonymous: );
Execute Anonymous: 
Execute Anonymous: // Nível 2: Frete por ESTADO (Mais genérico - R$ 1200)
Execute Anonymous: Freight__c freteEstado = new Freight__c(
Execute Anonymous:     Product__c = item.Product2Id,
Execute Anonymous:     State__c = ped.State__c,
Execute Anonymous:     DistributionCenter__c = ped.DistributionCenter__c,
Execute Anonymous:     FreightValue__c = 1200.00,
Execute Anonymous:     Status__c = 'Approved'
Execute Anonymous: );
Execute Anonymous: 
Execute Anonymous: insert new List<Freight__c>{freteCidade, freteEstado};
Execute Anonymous: 
Execute Anonymous: // --- TESTE 1: BUSCA POR CIDADE ---
Execute Anonymous: update item;
Execute Anonymous: OrderItem res1 = [SELECT FreightValue__c FROM OrderItem WHERE Id = :item.Id];
Execute Anonymous: System.debug('--- TESTE 1 (MAIS ESPECÍFICO) ---');
Execute Anonymous: System.debug('FRETE ENCONTRADO (CIDADE): R$ ' + res1.FreightValue__c);
Execute Anonymous: 
Execute Anonymous: // --- TESTE 2: REMOVE A CIDADE E TESTA A HIERARQUIA (ESTADO) ---
Execute Anonymous: delete freteCidade; 
Execute Anonymous: update item; // A Trigger tem que recalcular e achar o de R$ 1200 agora!
Execute Anonymous: 
Execute Anonymous: OrderItem res2 = [SELECT FreightValue__c FROM OrderItem WHERE Id = :item.Id];
Execute Anonymous: System.debug('--- TESTE 2 (HIERARQUIA / ESTADO) ---');
Execute Anonymous: System.debug('FRETE ENCONTRADO APÓS DELETE: R$ ' + res2.FreightValue__c);
