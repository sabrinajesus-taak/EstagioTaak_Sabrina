66.0 APEX_CODE,DEBUG;APEX_PROFILING,INFO
Execute Anonymous: // 1. PEGA OS IDS REAIS DO SEU PEDIDO (Direto da fonte)
Execute Anonymous: Order ped = [SELECT Id, DistributionCenter__c, City__c FROM Order WHERE OrderNumber = '00000100' LIMIT 1];
Execute Anonymous: OrderItem item = [SELECT Id, Product2Id FROM OrderItem WHERE OrderId = :ped.Id LIMIT 1];
Execute Anonymous: 
Execute Anonymous: // 2. LIMPA TUDO PARA NÃO TER RUÍDO
Execute Anonymous: delete [SELECT Id FROM Margem__c WHERE Product__c = :item.Product2Id];
Execute Anonymous: 
Execute Anonymous: // 3. CRIA A MARGEM COPIANDO OS IDS DO PEDIDO (O "DNA" idêntico)
Execute Anonymous: Margem__c m1 = new Margem__c();
Execute Anonymous: m1.Product__c = item.Product2Id;
Execute Anonymous: m1.DistributionCenter__c = ped.DistributionCenter__c; // ID EXATO DO PEDIDO
Execute Anonymous: m1.City__c = ped.City__c;                             // ID EXATO DO PEDIDO
Execute Anonymous: m1.MarginValuePercent__c = 45;
Execute Anonymous: m1.Status__c = 'Approved';
Execute Anonymous: insert m1;
Execute Anonymous: 
Execute Anonymous: // 4. DÁ O "UPDATE" PARA DISPARAR A TRIGGER
Execute Anonymous: update item;
Execute Anonymous: 
Execute Anonymous: // 5. O VEREDITO
Execute Anonymous: OrderItem res = [SELECT MarginPercentage__c, UnitPrice FROM OrderItem WHERE Id = :item.Id];
Execute Anonymous: System.debug('--- 🧐 ANALISANDO OS IDS ---');
Execute Anonymous: System.debug('ID do CD no Pedido: ' + ped.DistributionCenter__c);
Execute Anonymous: System.debug('ID da Cidade no Pedido: ' + ped.City__c);
Execute Anonymous: System.debug('RESULTADO FINAL - Margem: ' + res.MarginPercentage__c + '%');
