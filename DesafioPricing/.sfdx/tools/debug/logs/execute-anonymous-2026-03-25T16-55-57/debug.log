66.0 APEX_CODE,DEBUG;APEX_PROFILING,INFO
Execute Anonymous: // 1. PEGA O PEDIDO (Para pegar os locais: Cidade, Estado, CD)
Execute Anonymous: Order ped = [SELECT Id, AccountId, City__c, State__c, Country__c, DistributionCenter__c 
Execute Anonymous:              FROM Order WHERE OrderNumber = '00000100' LIMIT 1];
Execute Anonymous: 
Execute Anonymous: // 2. PEGA O ITEM (Para pegar o Produto real que está lá)
Execute Anonymous: OrderItem item = [SELECT Id, Product2Id FROM OrderItem 
Execute Anonymous:                  WHERE OrderId = :ped.Id AND Product2.Name LIKE '%Colheitadeira%' LIMIT 1];
Execute Anonymous: 
Execute Anonymous: // 3. LIMPEZA TOTAL (Para o teste ser puro)
Execute Anonymous: delete [SELECT Id FROM Margem__c WHERE Product__c = :item.Product2Id];
Execute Anonymous: delete [SELECT Id FROM Freight__c WHERE Product__c = :item.Product2Id];
Execute Anonymous: 
Execute Anonymous: // 4. CRIA A MARGEM (Match: Produto + Conta + Cidade + Estado + CD)
Execute Anonymous: Margem__c m1 = new Margem__c();
Execute Anonymous: m1.Product__c = item.Product2Id;
Execute Anonymous: m1.Account__c = ped.AccountId;
Execute Anonymous: m1.City__c = ped.City__c;                   
Execute Anonymous: m1.State__c = ped.State__c;                 
Execute Anonymous: m1.DistributionCenter__c = ped.DistributionCenter__c; 
Execute Anonymous: m1.MarginValuePercent__c = 45;
Execute Anonymous: m1.Status__c = 'Approved';
Execute Anonymous: insert m1;
Execute Anonymous: 
Execute Anonymous: // 5. CRIA O FRETE (Match: Produto + Estado + CD) - RESPEITANDO A REGRA DE VALIDAÇÃO
Execute Anonymous: Freight__c f = new Freight__c();
Execute Anonymous: f.Product__c = item.Product2Id;
Execute Anonymous: f.State__c = ped.State__c;                 // ID do Lookup de Estado (Obrigatório)
Execute Anonymous: f.City__c = ped.City__c;                   
Execute Anonymous: f.DistributionCenter__c = ped.DistributionCenter__c; // ORIGEM OBRIGATÓRIA!
Execute Anonymous: f.FreightValue__c = 50.00;
Execute Anonymous: f.Status__c = 'Approved';
Execute Anonymous: insert f;
Execute Anonymous: 
Execute Anonymous: // 6. UPDATE PARA DISPARAR O PRICINGSERVICE (O Momento da Verdade)
Execute Anonymous: update item;
Execute Anonymous: 
Execute Anonymous: // 7. VERIFICAÇÃO FINAL (AUDITORIA)
Execute Anonymous: OrderItem res = [SELECT MarginPercentage__c, FreightValue__c, UnitPrice FROM OrderItem WHERE Id = :item.Id];
Execute Anonymous: 
Execute Anonymous: System.debug('--- 🏁 AUDITORIA FINAL ---');
Execute Anonymous: System.debug('Margem Aplicada: ' + res.MarginPercentage__c + '%');
Execute Anonymous: System.debug('Frete Aplicado: R$ ' + res.FreightValue__c);
Execute Anonymous: System.debug('Preço Unitário Final: R$ ' + res.UnitPrice);
Execute Anonymous: 
Execute Anonymous: if(res.MarginPercentage__c == 45) {
Execute Anonymous:     System.debug('✅ VITÓRIA, SABRINA! O 45% finalmente apareceu no Item!');
Execute Anonymous: }
