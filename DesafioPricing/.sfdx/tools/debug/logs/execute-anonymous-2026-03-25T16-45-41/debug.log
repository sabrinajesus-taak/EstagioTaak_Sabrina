Execute Anonymous: // 1. DADOS DO PEDIDO (Pegando o CD e a Cidade direto do Pedido 00000100)
Execute Anonymous: Order ped = [SELECT Id, DistributionCenter__c, City__c, AccountId 
Execute Anonymous:              FROM Order WHERE OrderNumber = '00000100' LIMIT 1];
Execute Anonymous: 
Execute Anonymous: // Busca a Colheitadeira que está no pedido
Execute Anonymous: OrderItem item = [SELECT Id, Product2Id FROM OrderItem 
Execute Anonymous:                  WHERE OrderId = :ped.Id AND Product2.Name LIKE '%Colheitadeira%' LIMIT 1];
Execute Anonymous: 
Execute Anonymous: // 2. LIMPEZA (Para o teste ser limpo e novo)
Execute Anonymous: delete [SELECT Id FROM Margem__c WHERE Product__c = :item.Product2Id];
Execute Anonymous: delete [SELECT Id FROM Freight__c WHERE Product__c = :item.Product2Id];
Execute Anonymous: 
Execute Anonymous: // 3. CRIA A MARGEM (45%) - Incluindo o Centro de Distribuição!
Execute Anonymous: insert new Margem__c(
Execute Anonymous:     Product__c = item.Product2Id,
Execute Anonymous:     Account__c = ped.AccountId,
Execute Anonymous:     City__c = ped.City__c,
Execute Anonymous:     DistributionCenter__c = ped.DistributionCenter__c, // OBRIGATÓRIO!
Execute Anonymous:     MarginValuePercent__c = 45,
Execute Anonymous:     Status__c = 'Approved'
Execute Anonymous: );
Execute Anonymous: 
Execute Anonymous: // 4. CRIA O FRETE (R$ 50,00) - Incluindo o Centro de Distribuição!
Execute Anonymous: insert new Freight__c(
Execute Anonymous:     Product__c = item.Product2Id,
Execute Anonymous:     City__c = ped.City__c,
Execute Anonymous:     DistributionCenter__c = ped.DistributionCenter__c, // OBRIGATÓRIO!
Execute Anonymous:     FreightValue__c = 50.00,
Execute Anonymous:     Status__c = 'Approved'
Execute Anonymous: );
Execute Anonymous: 
Execute Anonymous: // 5. UPDATE PARA DISPARAR A TRIGGER E O PRICINGSERVICE
Execute Anonymous: update item;
Execute Anonymous: 
Execute Anonymous: // 6. VERIFICAÇÃO FINAL (AUDITORIA)
Execute Anonymous: OrderItem res = [SELECT MarginPercentage__c, FreightValue__c, UnitPrice FROM OrderItem WHERE Id = :item.Id];
Execute Anonymous: 
Execute Anonymous: System.debug('--- 🏆 AUDITORIA FINALIZADA ---');
Execute Anonymous: System.debug('Centro de Distribuição Utilizado: ' + ped.DistributionCenter__c);
Execute Anonymous: System.debug('Margem Gravada no Item: ' + res.MarginPercentage__c + '%');
Execute Anonymous: System.debug('Frete Gravada no Item: R$ ' + res.FreightValue__c);
Execute Anonymous: System.debug('Preço Final Calculado: R$ ' + res.UnitPrice);
Execute Anonymous: 
Execute Anonymous: if(res.MarginPercentage__c == 45) {
Execute Anonymous:     System.debug('✅ TAREFA CONCLUÍDA! O CD bateu e o cálculo funcionou!');
Execute Anonymous: } else {
Execute Anonymous:     System.debug('❌ Ainda null? Verifica se o Status na sua Picklist é "Approved" ou "Aprovado"!');
Execute Anonymous: }
