66.0 APEX_CODE,DEBUG;APEX_PROFILING,INFO
Execute Anonymous: // 1. SETUP DO PRODUTO E PEDIDO
Execute Anonymous: Product2 prod = [SELECT Id, ProductHierarchy__c FROM Product2 WHERE Name = 'GenWatt Diesel 1000kW' LIMIT 1];
Execute Anonymous: Order ped = [SELECT Id, AccountId, City__c, State__c, DistributionCenter__c, Pricebook2Id 
Execute Anonymous:              FROM Order WHERE OrderNumber = '00000100' LIMIT 1]; 
Execute Anonymous: 
Execute Anonymous: PricebookEntry pbe = [SELECT Id, UnitPrice FROM PricebookEntry 
Execute Anonymous:                       WHERE Product2Id = :prod.Id AND Pricebook2Id = :ped.Pricebook2Id LIMIT 1];
Execute Anonymous: 
Execute Anonymous: Account acc = [SELECT Id, AccountGroup__c FROM Account WHERE Id = :ped.AccountId];
Execute Anonymous: 
Execute Anonymous: // 2. LIMPEZA DE DADOS ANTIGOS
Execute Anonymous: delete [SELECT Id FROM Margem__c WHERE Product__c = :prod.Id OR ProductHierarchy__c = :prod.ProductHierarchy__c];
Execute Anonymous: 
Execute Anonymous: // 3. CRIANDO OS NÍVEIS SEPARADOS (Respeitando sua Regra de Validação)
Execute Anonymous: // Vamos criar apenas UM registro por vez para o sistema não se confundir
Execute Anonymous: Margem__c m1 = new Margem__c();
Execute Anonymous: m1.Product__c = prod.Id;
Execute Anonymous: m1.Account__c = acc.Id;
Execute Anonymous: m1.City__c = ped.City__c;
Execute Anonymous: m1.DistributionCenter__c = ped.DistributionCenter__c;
Execute Anonymous: m1.MarginValuePercent__c = 45;
Execute Anonymous: m1.Status__c = 'Approved';
Execute Anonymous: insert m1; 
Execute Anonymous: 
Execute Anonymous: // 4. INSERÇÃO DO ITEM (Aqui a Trigger vai rodar)
Execute Anonymous: OrderItem novoItem = new OrderItem(
Execute Anonymous:     OrderId = ped.Id, 
Execute Anonymous:     Product2Id = prod.Id, 
Execute Anonymous:     PricebookEntryId = pbe.Id,
Execute Anonymous:     Quantity = 1, 
Execute Anonymous:     UnitPrice = pbe.UnitPrice
Execute Anonymous: );
Execute Anonymous: insert novoItem;
Execute Anonymous: 
Execute Anonymous: // 5. VERIFICAÇÃO FINAL NO LOG
Execute Anonymous: OrderItem result = [SELECT MarginPercentage__c, UnitPrice FROM OrderItem WHERE Id = :novoItem.Id];
Execute Anonymous: 
Execute Anonymous: System.debug('--- 🏆 RESULTADO FINAL DO DESAFIO ---');
Execute Anonymous: System.debug('Margem aplicada: ' + result.MarginPercentage__c + '%');
Execute Anonymous: System.debug('Preço Final Calculado: R$ ' + result.UnitPrice);
Execute Anonymous: 
Execute Anonymous: if(result.MarginPercentage__c == 45) {
Execute Anonymous:     System.debug('✅ SUCESSO: A Trigger priorizou a margem de Produto!');
Execute Anonymous: }
