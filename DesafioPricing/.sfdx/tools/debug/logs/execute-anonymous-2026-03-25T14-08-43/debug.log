Execute Anonymous: // 1. BUSCA O PRODUTO
Execute Anonymous: Product2 prod = [SELECT Id, ProductHierarchy__c FROM Product2 WHERE Name = 'Colheitadeira S700' LIMIT 1];
Execute Anonymous: 
Execute Anonymous: // 2. BUSCA O PEDIDO QUE VOCÊ ACABOU DE CRIAR
Execute Anonymous: // (Ele vai pegar o mais recente que tem Cidade e CD)
Execute Anonymous: Order ped = [SELECT Id, AccountId, City__c, State__c, DistributionCenter__c, Pricebook2Id 
Execute Anonymous:              FROM Order 
Execute Anonymous:              WHERE City__c != null AND DistributionCenter__c != null 
Execute Anonymous:              ORDER BY CreatedDate DESC LIMIT 1];
Execute Anonymous: 
Execute Anonymous: // 3. BUSCA O PREÇO DO PRODUTO (O tal do PricebookEntry que deu erro)
Execute Anonymous: // Vamos procurar o preço desse produto na tabela que está no seu pedido
Execute Anonymous: PricebookEntry pbe = [SELECT Id, UnitPrice FROM PricebookEntry 
Execute Anonymous:                       WHERE Product2Id = :prod.Id 
Execute Anonymous:                       AND Pricebook2Id = :ped.Pricebook2Id 
Execute Anonymous:                       AND IsActive = true LIMIT 1];
Execute Anonymous: 
Execute Anonymous: Account acc = [SELECT Id, AccountGroup__c FROM Account WHERE Id = :ped.AccountId];
Execute Anonymous: 
Execute Anonymous: // 4. LIMPEZA E CRIAÇÃO DAS MARGENS
Execute Anonymous: delete [SELECT Id FROM Margem__c WHERE Product__c = :prod.Id OR ProductHierarchy__c = :prod.ProductHierarchy__c];
Execute Anonymous: 
Execute Anonymous: List<Margem__c> margens = new List<Margem__c>();
Execute Anonymous: margens.add(new Margem__c(
Execute Anonymous:     Product__c = prod.Id, Account__c = acc.Id, City__c = ped.City__c, 
Execute Anonymous:     DistributionCenter__c = ped.DistributionCenter__c, MarginValuePercent__c = 30, Status__c = 'Approved'
Execute Anonymous: ));
Execute Anonymous: margens.add(new Margem__c(
Execute Anonymous:     ProductHierarchy__c = prod.ProductHierarchy__c, DistributionCenter__c = ped.DistributionCenter__c,
Execute Anonymous:     MarginValuePercent__c = 10, Status__c = 'Approved'
Execute Anonymous: ));
Execute Anonymous: insert margens;
Execute Anonymous: 
Execute Anonymous: // 5. INSERÇÃO DO ITEM (Agora com o PBE Id para não dar erro!)
Execute Anonymous: OrderItem novoItem = new OrderItem(
Execute Anonymous:     OrderId = ped.Id, 
Execute Anonymous:     Product2Id = prod.Id, 
Execute Anonymous:     PricebookEntryId = pbe.Id, // <--- O SALVADOR DA PÁTRIA!
Execute Anonymous:     Quantity = 1, 
Execute Anonymous:     UnitPrice = pbe.UnitPrice // Preço base da tabela
Execute Anonymous: );
Execute Anonymous: insert novoItem;
Execute Anonymous: 
Execute Anonymous: // 6. VERIFICAÇÃO NO LOG
Execute Anonymous: OrderItem result = [SELECT MarginPercentage__c, UnitPrice FROM OrderItem WHERE Id = :novoItem.Id];
Execute Anonymous: System.debug('--- ✅ FINALMENTE! SUCESSO NO TESTE ---');
Execute Anonymous: System.debug('Margem Escolhida: ' + result.MarginPercentage__c + '%');
Execute Anonymous: System.debug('Preço com Margem e Imposto: R$ ' + result.UnitPrice);
